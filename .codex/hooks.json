{
  "description": "Repository-local Codex automation migrated from .cursor hooks.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/slim_core_continue.py\"",
            "timeout": 30,
            "statusMessage": "Checking the slim-core queue"
          }
        ]
      }
    ]
  }
}
